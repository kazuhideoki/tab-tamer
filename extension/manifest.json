{
  "manifest_version": 3,
  "name": "Tab Tamer",
  "version": "0.1.0",
  "description": "Rule-based grouping, duplicate prevention, copying and automatic tab suspension.",
  "minimum_chrome_version": "127",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webNavigation",
    "offscreen",
    "clipboardWrite",
    "notifications",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media-watch.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "suspension-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "interaction.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "copy-toast.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Tamer",
    "default_popup": "status.html"
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "\u73fe\u5728\u306e\u30bf\u30d6\u306eURL\u3092\u30b3\u30d4\u30fc"
    },
    "copy-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "\u73fe\u5728\u306e\u30bf\u30d6\u3092Markdown\u30ea\u30f3\u30af\u3068\u3057\u3066\u30b3\u30d4\u30fc"
    }
  }
}
